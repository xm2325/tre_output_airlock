{
  "realm": "airlock-ci",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {"name": "airlock-researcher"},
    {"name": "airlock-reviewer"},
    {"name": "airlock-admin"}
  ],
  "clients": [
    {
      "clientId": "airlock-api",
      "name": "TRE Output Airlock CI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "airlock-ci-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "airlock-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "researcher-ci",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "researcher-pass", "temporary": false}
      ],
      "groups": ["/airlock-researcher"]
    },
    {
      "username": "reviewer-ci",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "reviewer-pass", "temporary": false}
      ],
      "groups": ["/airlock-reviewer"]
    },
    {
      "username": "admin-ci",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "admin-pass", "temporary": false}
      ],
      "groups": ["/airlock-admin"]
    }
  ]
}

# Docker Compose local defaults. Replace these values outside local demonstration use.
POSTGRES_PASSWORD=airlock-local-only
AIRLOCK_REPORT_SIGNING_SECRET=demo-signing-secret-change-me
AIRLOCK_RETENTION_DAYS=30
AIRLOCK_REVIEW_CLAIM_TTL_MINUTES=30

# Local browser/API demonstration keeps header-based identity by default.
AIRLOCK_AUTH_MODE=demo

# To exercise an OAuth2/OIDC token-introspection identity provider instead, set:
# AIRLOCK_AUTH_MODE=oidc_introspection
# AIRLOCK_OIDC_INTROSPECTION_URL=https://example.okta.test/oauth2/default/v1/introspect
# AIRLOCK_OIDC_CLIENT_ID=airlock-api
# AIRLOCK_OIDC_CLIENT_SECRET=replace-me
# AIRLOCK_OIDC_EXPECTED_AUDIENCE=airlock-api
# AIRLOCK_OIDC_EXPECTED_ISSUER=https://example.okta.test/oauth2/default
# AIRLOCK_OIDC_ROLE_CLAIM=groups
# AIRLOCK_OIDC_ROLE_MAP=research-group:researcher,review-group:reviewer,admin-group:admin
# AIRLOCK_OIDC_TIMEOUT_SECONDS=3.0
# AIRLOCK_OIDC_CACHE_TTL_SECONDS=15
# AIRLOCK_OIDC_CACHE_MAX_ENTRIES=2048

# Direct backend execution defaults to SQLite for low-friction local development.
AIRLOCK_DATABASE_URL=sqlite:///./data/airlock.db
AIRLOCK_AUTO_CREATE_SCHEMA=true
AIRLOCK_QUARANTINE_DIR=./quarantine
AIRLOCK_MAX_FILE_SIZE_MB=5
AIRLOCK_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ECS/RDS deployment can omit AIRLOCK_DATABASE_URL and inject these values separately:
# AIRLOCK_DATABASE_HOST=private-rds.example
# AIRLOCK_DATABASE_PORT=5432
# AIRLOCK_DATABASE_NAME=airlock
# AIRLOCK_DATABASE_USER=airlock-service
# AIRLOCK_DATABASE_PASSWORD=replace-me
# AIRLOCK_DATABASE_POOL_SIZE=5
# AIRLOCK_DATABASE_MAX_OVERFLOW=5
# AIRLOCK_DATABASE_POOL_TIMEOUT_SECONDS=5.0
# AIRLOCK_DATABASE_POOL_RECYCLE_SECONDS=900
# AIRLOCK_RUN_MIGRATIONS=false

# Asynchronous scan execution. Local/demo runs stay synchronous by default.
# AWS reference tasks use queued mode with SQS, a transactional outbox publisher and workers.
# AIRLOCK_SCAN_MODE=queued
# AIRLOCK_SCAN_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789012/airlock-scan
# AIRLOCK_AWS_REGION=eu-west-2
# AIRLOCK_SQS_ENDPOINT_URL=
# AIRLOCK_OUTBOX_BATCH_SIZE=10
# AIRLOCK_OUTBOX_CLAIM_TTL_SECONDS=30
# AIRLOCK_SCAN_WORKER_CLAIM_TTL_SECONDS=60
# AIRLOCK_SQS_WAIT_TIME_SECONDS=10
# AIRLOCK_SQS_VISIBILITY_TIMEOUT_SECONDS=120

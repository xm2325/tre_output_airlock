{
  "realm": "airlock-ci",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "groups": [
    {"name": "airlock-researcher"},
    {"name": "airlock-reviewer"},
    {"name": "airlock-admin"}
  ],
  "clients": [
    {
      "clientId": "airlock-api",
      "name": "Airlock API audience",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "airlock-backend",
      "name": "Airlock backend CI client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AIRLOCK_KC_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "airlock-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "airlock-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "airlock_subject",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "airlock-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "airlock-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "researcher-ci",
      "enabled": true,
      "email": "researcher-ci@example.invalid",
      "firstName": "Researcher",
      "lastName": "CI",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "${AIRLOCK_KC_RESEARCHER_PASSWORD}", "temporary": false}],
      "groups": ["/airlock-researcher"]
    },
    {
      "username": "reviewer-ci",
      "enabled": true,
      "email": "reviewer-ci@example.invalid",
      "firstName": "Reviewer",
      "lastName": "CI",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "${AIRLOCK_KC_REVIEWER_PASSWORD}", "temporary": false}],
      "groups": ["/airlock-reviewer"]
    },
    {
      "username": "admin-ci",
      "enabled": true,
      "email": "admin-ci@example.invalid",
      "firstName": "Admin",
      "lastName": "CI",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "${AIRLOCK_KC_ADMIN_PASSWORD}", "temporary": false}],
      "groups": ["/airlock-admin"]
    },
    {
      "username": "unmapped-ci",
      "enabled": true,
      "email": "unmapped-ci@example.invalid",
      "firstName": "Unmapped",
      "lastName": "CI",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "${AIRLOCK_KC_UNMAPPED_PASSWORD}", "temporary": false}]
    }
  ]
}
